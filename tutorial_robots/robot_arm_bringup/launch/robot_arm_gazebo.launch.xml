<launch>
    <let name="urdf_path"
        value="$(find-pkg-share robot_arm_description)/urdf/robot_arm.xacro"></let>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"></param>
    </node>

    <arg name="world" default="empty.sdf"></arg>
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world) -r"></arg>
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description"></node>


    <!-- launch MoveIt move_group -->
    <include file="$(find-pkg-share robot_arm_moveit_config)/launch/move_group.launch.py"></include>

    <!-- launch RViz with MoveIt (handles timing and SRDF parameter setup) -->
    <include file="$(find-pkg-share robot_arm_moveit_config)/launch/moveit_rviz.launch.py"></include>

</launch>