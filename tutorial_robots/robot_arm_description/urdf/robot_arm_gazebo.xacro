<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo plugins for joint control and state publishing -->

    <!-- Joint position controller for base_shoulder_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>base_shoulder_joint</joint_name>
            <p_gain>100.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>50.0</d_gain>
            <cmd_max>100.0</cmd_max>
            <cmd_min>-100.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint position controller for shoulder_arm_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>shoulder_arm_joint</joint_name>
            <p_gain>100.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>50.0</d_gain>
            <cmd_max>100.0</cmd_max>
            <cmd_min>-100.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint position controller for arm_elbow_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>arm_elbow_joint</joint_name>
            <p_gain>100.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>50.0</d_gain>
            <cmd_max>100.0</cmd_max>
            <cmd_min>-100.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint position controller for elbow_forearm_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>elbow_forearm_joint</joint_name>
            <p_gain>100.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>50.0</d_gain>
            <cmd_max>100.0</cmd_max>
            <cmd_min>-100.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint position controller for forearm_wrist_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>forearm_wrist_joint</joint_name>
            <p_gain>100.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>50.0</d_gain>
            <cmd_max>100.0</cmd_max>
            <cmd_min>-100.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint position controller for wrist_hand_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>wrist_hand_joint</joint_name>
            <p_gain>100.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>50.0</d_gain>
            <cmd_max>100.0</cmd_max>
            <cmd_min>-100.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint position controller for gripper_left_finger_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>gripper_left_finger_joint</joint_name>
            <p_gain>50.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>5.0</d_gain>
            <cmd_max>50.0</cmd_max>
            <cmd_min>-50.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint position controller for gripper_right_finger_joint -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>gripper_right_finger_joint</joint_name>
            <p_gain>50.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>5.0</d_gain>
            <cmd_max>50.0</cmd_max>
            <cmd_min>-50.0</cmd_min>
        </plugin>
    </gazebo>

    <!-- Joint state publisher to read joint states from Gazebo -->
    <gazebo>
        <plugin 
            filename="gz-sim-joint-state-publisher-system" 
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>base_shoulder_joint</joint_name>
            <joint_name>shoulder_arm_joint</joint_name>
            <joint_name>arm_elbow_joint</joint_name>
            <joint_name>elbow_forearm_joint</joint_name>
            <joint_name>forearm_wrist_joint</joint_name>
            <joint_name>wrist_hand_joint</joint_name>
            <joint_name>gripper_left_finger_joint</joint_name>
            <joint_name>gripper_right_finger_joint</joint_name>
        </plugin>
    </gazebo>

</robot>
